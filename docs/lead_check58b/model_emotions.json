        "fx": "flash",
        "sfx": "오싹",
        "face": "surprised"
      },
      {
        "type": "line",
        "speaker": "나레이션",
        "display": "",
        "style": "narration",
        "text": "터벅, 터벅.",
        "by": "script",
        "sfx": "터벅"
      },
      {
        "type": "line",
        "speaker": "남자",
        "display": "붉은 눈의 남자",
        "style": "speech",
        "text": "…",
        "by": "script",
        "sfx": "스윽"
      },
