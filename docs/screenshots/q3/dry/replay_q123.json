{
  "q1_hood_off_block": [
    {
      "who": "GM",
      "t": "북대륙의 크롬웰 제국과 남대륙의 사막 대국 페시안은 오랜 적이다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "두 대륙 사이에는 생명이 살지 않는 죽음의 사막, 지르다가 펼쳐져 있다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "아시나는 크롬웰 제국 웰든 대공가의 공녀다. 여행이 좋아 신분을 숨기고 대륙을 떠돌고 있다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "본모습은 은발에 붉은 눈. 마법 귀찌로 머리와 눈을 갈색으로 바꿨다. 남대륙은 적국 페시안의 땅이라, 크롬웰의 공녀라는 게 들키면 붙잡히거나 목숨을 잃을 수도 있다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "남대륙의 도시 크라차로 가려고 지르다에 들어선 지 일주일. 길을 잃었고, 물이 떨어져 간다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "귀찌의 힘에도 끝이 있다. 시간이 흐를수록 마음이 급해진다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "GM",
      "t": "살아서 사막을 건널 것. 그리고 정체를 들키지 않을 것.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "여는 글"
    },
    {
      "who": "(서술)",
      "t": "꿈에도 몰랐다. 거대한 태양 아래, 고국이 아닌 낯선 땅에서 죽음을 맞이하게 될 줄은―",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "(서술)",
      "t": "북대륙을 한 바퀴 돌고 나니 남대륙이 궁금해졌다. 목적지는 크라차. 사막 하나만 건너면 되는 줄 알았다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "(하아… 하아…)",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "(길을 헤맨 지 벌써 일주일째야…)",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "(사방이 온통 모래뿐이라 길을 알 수가 없어…)",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "(심지어 물도 다 떨어져 가고…)",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "입력",
      "t": "남은 물을 한 모금만 마신다",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "GM",
      "t": "주사위 두 개의 합에 체력 수치(+0)를 더한다. 10 이상이면 성공, 7~9는 대가 있는 성공, 6 이하는 실패.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "판정",
      "t": "남은 물을 아껴 마신다 · 체력 판정 · 5 + 4 +0(체력) = 9 / 목표 10 → 대가 있는 성공",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "(딱 한 모금만… 아, 두 모금 마셔 버렸어.)",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "(서술)",
      "t": "그래도 물통 바닥에 조금은 남겨 두었다.",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "길 잃은 지 일주일"
    },
    {
      "who": "아시나",
      "t": "응?",
      "gmWritten": false,
      "bg": "desert_wide.png",
      "scene": "사람?!",
      "shot": "/Users/choeminju/월흔_trpg/docs/screenshots/q3/dry/q1_hood_off_block_01.png"
    },
    {
